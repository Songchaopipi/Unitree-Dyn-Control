prefix=${pcfiledir}/../..
exec_prefix=${pcfiledir}/../..
libdir=${pcfiledir}/../../lib
bindir=${pcfiledir}/../../bin
pkglibdir=${pcfiledir}/../../lib/aligator
includedir=${pcfiledir}/../../include
datarootdir=${pcfiledir}/../../share
pkgdatarootdir=${pcfiledir}/../../share
docdir=
doxygendocdir=

Name: aligator
Description: A versatile and efficient C++ library for real-time constrained trajectory optimization.
URL: https://github.com/Simple-Robotics/aligator
Version: 0.18.0
Requires: eigen3 >= 3.3.7, fmt >= 10.0.0, pinocchio >= 3.4.0
Conflicts: 
Libs: -L${libdir}  -laligator -L/home/songchao/anaconda3/lib -lboost_filesystem
Libs.private: 
Cflags:  -I${includedir} -DALIGATOR_ENABLE_TEMPLATE_INSTANTIATION -DALIGATOR_WITH_PINOCCHIO


